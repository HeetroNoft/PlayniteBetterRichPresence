<UserControl x:Class="BetterRichPresence.BetterRichPresenceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BetterRichPresence">
    <!-- Texts come from Localization/<language>.xaml. -->
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="Header" BasedOn="{StaticResource {x:Type TextBlock}}">
            <!-- BasedOn finds WPF's default TextBlock style, not the theme's: take the theme's text color explicitly. -->
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <CheckBox Content="{DynamicResource LOC_BRP_Enabled}" IsChecked="{Binding Settings.Enabled}" />

            <TextBlock Style="{StaticResource Header}" Text="{DynamicResource LOC_BRP_HeaderApplication}" />
            <CheckBox Content="{DynamicResource LOC_BRP_UseGameApplications}"
                      IsChecked="{Binding Settings.UseGameApplications}" />
            <DockPanel Margin="0,4">
                <Button Content="{DynamicResource LOC_BRP_RefreshCatalog}" DockPanel.Dock="Left" Command="{Binding RefreshCatalogCommand}" />
                <TextBlock Text="{Binding CatalogStatus}" VerticalAlignment="Center" Margin="10,0" />
            </DockPanel>
            <DockPanel Margin="0,4">
                <TextBlock Text="{DynamicResource LOC_BRP_FallbackApplicationId}" VerticalAlignment="Center" Width="180" />
                <TextBox Text="{Binding Settings.FallbackApplicationId}" />
            </DockPanel>
            <DockPanel Margin="0,4">
                <TextBlock Text="{DynamicResource LOC_BRP_FallbackImage}" VerticalAlignment="Center" Width="180" />
                <TextBox Text="{Binding Settings.FallbackImage}" />
            </DockPanel>
            <Button Content="{DynamicResource LOC_BRP_ResetApplication}" HorizontalAlignment="Left" Margin="180,4,0,4"
                    Command="{Binding ResetDiscordApplicationCommand}" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7" Text="{DynamicResource LOC_BRP_FallbackHelp}" />

            <TextBlock Style="{StaticResource Header}" Text="{DynamicResource LOC_BRP_HeaderMatched}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource LOC_BRP_Details}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Margin="0,2" Text="{Binding Settings.MatchedDetails}" />
                <TextBlock Grid.Row="1" Text="{DynamicResource LOC_BRP_State}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding Settings.MatchedState}" />
                <TextBlock Grid.Row="2" Text="{DynamicResource LOC_BRP_MemberListShows}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" SelectedValuePath="Tag"
                          SelectedValue="{Binding Settings.MatchedStatusDisplay}">
                    <ComboBoxItem Content="{DynamicResource LOC_BRP_StatusGameName}" Tag="{x:Static local:StatusDisplay.Name}" />
                    <ComboBoxItem Content="{DynamicResource LOC_BRP_StatusState}" Tag="{x:Static local:StatusDisplay.State}" />
                    <ComboBoxItem Content="{DynamicResource LOC_BRP_StatusDetails}" Tag="{x:Static local:StatusDisplay.Details}" />
                </ComboBox>
            </Grid>

            <TextBlock Style="{StaticResource Header}" Text="{DynamicResource LOC_BRP_HeaderFallback}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource LOC_BRP_Details}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Margin="0,2" Text="{Binding Settings.FallbackDetails}" />
                <TextBlock Grid.Row="1" Text="{DynamicResource LOC_BRP_State}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding Settings.FallbackState}" />
                <TextBlock Grid.Row="2" Text="{DynamicResource LOC_BRP_MemberListShows}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" SelectedValuePath="Tag"
                          SelectedValue="{Binding Settings.FallbackStatusDisplay}">
                    <ComboBoxItem Content="{DynamicResource LOC_BRP_StatusApplicationName}" Tag="{x:Static local:StatusDisplay.Name}" />
                    <ComboBoxItem Content="{DynamicResource LOC_BRP_StatusState}" Tag="{x:Static local:StatusDisplay.State}" />
                    <ComboBoxItem Content="{DynamicResource LOC_BRP_StatusDetails}" Tag="{x:Static local:StatusDisplay.Details}" />
                </ComboBox>
            </Grid>

            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7" Text="{DynamicResource LOC_BRP_GamePlaceholders}" />

            <TextBlock Style="{StaticResource Header}" Text="{DynamicResource LOC_BRP_HeaderDisplay}" />
            <CheckBox Content="{DynamicResource LOC_BRP_ShowElapsedTime}" IsChecked="{Binding Settings.ShowElapsedTime}" />
            <CheckBox Content="{DynamicResource LOC_BRP_ShowPlayniteBadge}" IsChecked="{Binding Settings.ShowPlayniteBadge}" />
            <CheckBox Content="{DynamicResource LOC_BRP_ShowGameImage}" IsChecked="{Binding Settings.ShowGameImage}" />
            <StackPanel Margin="24,0,0,0" IsEnabled="{Binding Settings.ShowGameImage}">
                <DockPanel Margin="0,4">
                    <TextBlock Text="{DynamicResource LOC_BRP_GameImageKind}" VerticalAlignment="Center" Width="156" />
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Settings.GameImage}" Width="150" HorizontalAlignment="Left">
                        <ComboBoxItem Content="{DynamicResource LOC_BRP_ImageIcon}" Tag="{x:Static local:GameImageKind.Icon}" />
                        <ComboBoxItem Content="{DynamicResource LOC_BRP_ImageCover}" Tag="{x:Static local:GameImageKind.Cover}" />
                    </ComboBox>
                </DockPanel>
                <CheckBox Content="{DynamicResource LOC_BRP_UploadImages}" IsChecked="{Binding Settings.UploadLocalImages}" />
                <DockPanel Margin="24,4,0,0" IsEnabled="{Binding Settings.UploadLocalImages}">
                    <TextBlock Text="{DynamicResource LOC_BRP_ImgbbApiKey}" VerticalAlignment="Center" Width="132" />
                    <TextBox Text="{Binding Settings.ImgbbApiKey}" />
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="24,2,0,0">
                    <Run Text="{DynamicResource LOC_BRP_UploadHelpBefore}" />
                    <Hyperlink NavigateUri="https://api.imgbb.com/" RequestNavigate="Hyperlink_RequestNavigate">api.imgbb.com</Hyperlink>
                    <Run Text="{DynamicResource LOC_BRP_UploadHelpAfter}" />
                </TextBlock>
            </StackPanel>

            <TextBlock Style="{StaticResource Header}" Text="{DynamicResource LOC_BRP_HeaderIdle}" />
            <CheckBox Content="{DynamicResource LOC_BRP_ShowIdlePresence}" IsChecked="{Binding Settings.ShowIdlePresence}" />
            <Grid IsEnabled="{Binding Settings.ShowIdlePresence}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource LOC_BRP_Details}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Margin="0,2" Text="{Binding Settings.IdleDetails}" />
                <TextBlock Grid.Row="1" Text="{DynamicResource LOC_BRP_State}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding Settings.IdleState}" />
            </Grid>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7" Text="{DynamicResource LOC_BRP_IdlePlaceholders}" />

            <Separator Margin="0,24,0,8" Opacity="0.3" />
            <TextBlock HorizontalAlignment="Center" Opacity="0.7">
                <Run Text="{DynamicResource LOC_BRP_Signature}" />
                <Hyperlink NavigateUri="https://github.com/HeetroNoft" RequestNavigate="Hyperlink_RequestNavigate">github.com/HeetroNoft</Hyperlink>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
