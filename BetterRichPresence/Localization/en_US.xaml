<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- English is the base language: every key must exist here. -->

    <!-- Settings: Discord application -->
    <sys:String x:Key="LOC_BRP_Enabled">Share my activity on Discord</sys:String>
    <sys:String x:Key="LOC_BRP_HeaderApplication">Discord application</sys:String>
    <sys:String x:Key="LOC_BRP_UseGameApplications">Show "Playing &lt;game&gt;" when Discord knows the game</sys:String>
    <sys:String x:Key="LOC_BRP_RefreshCatalog">Refresh list</sys:String>
    <sys:String x:Key="LOC_BRP_CatalogDownloading">Downloading…</sys:String>
    <sys:String x:Key="LOC_BRP_CatalogCount">{0} games known by Discord</sys:String>
    <sys:String x:Key="LOC_BRP_FallbackApplicationId">Fallback application ID:</sys:String>
    <sys:String x:Key="LOC_BRP_FallbackImage">Fallback image:</sys:String>
    <sys:String x:Key="LOC_BRP_ResetApplication">Reset to the plugin's application</sys:String>
    <sys:String x:Key="LOC_BRP_FallbackHelp">Used for games Discord doesn't know, and when browsing. The image is an asset key of the fallback application (Rich Presence → Art Assets in the Discord Developer Portal) or an image URL.</sys:String>

    <!-- Settings: presence text -->
    <sys:String x:Key="LOC_BRP_HeaderMatched">Text when Discord knows the game</sys:String>
    <sys:String x:Key="LOC_BRP_HeaderFallback">Text with the fallback application</sys:String>
    <sys:String x:Key="LOC_BRP_Details">Details:</sys:String>
    <sys:String x:Key="LOC_BRP_State">State:</sys:String>
    <sys:String x:Key="LOC_BRP_MemberListShows">Member list shows:</sys:String>
    <sys:String x:Key="LOC_BRP_StatusGameName">Game name</sys:String>
    <sys:String x:Key="LOC_BRP_StatusApplicationName">Application name</sys:String>
    <sys:String x:Key="LOC_BRP_StatusState">State</sys:String>
    <sys:String x:Key="LOC_BRP_StatusDetails">Details</sys:String>
    <sys:String x:Key="LOC_BRP_GamePlaceholders">Placeholders: {name} {platform} {source} {library} {playtime} {playcount} {completion} {genre} {developer} {year} {score}. Separators next to an empty value are removed, and a line whose values are all empty is hidden.</sys:String>

    <!-- Settings: display -->
    <sys:String x:Key="LOC_BRP_HeaderDisplay">Display</sys:String>
    <sys:String x:Key="LOC_BRP_ShowElapsedTime">Show elapsed time for the session</sys:String>
    <sys:String x:Key="LOC_BRP_ShowPlayniteBadge">Show the Playnite logo as a small badge on the game image</sys:String>
    <sys:String x:Key="LOC_BRP_ShowGameImage">Show a game image</sys:String>
    <sys:String x:Key="LOC_BRP_GameImageKind">Playnite image to show:</sys:String>
    <sys:String x:Key="LOC_BRP_ImageIcon">Icon</sys:String>
    <sys:String x:Key="LOC_BRP_ImageCover">Cover</sys:String>
    <sys:String x:Key="LOC_BRP_UploadImages">Upload Playnite images to ImgBB so Discord can display them</sys:String>
    <sys:String x:Key="LOC_BRP_ImgbbApiKey">ImgBB API key:</sys:String>
    <sys:String x:Key="LOC_BRP_UploadHelpBefore">Without a key, nothing is uploaded. Discord can only show images available online. Each image is converted to PNG and uploaded once to ImgBB: anyone with the link can see it. Get a free API key at</sys:String>
    <sys:String x:Key="LOC_BRP_UploadHelpAfter">(sign in, then "Get API key"). When this is off, or before the upload finishes, the Steam cover or Discord's icon for the game is shown instead.</sys:String>

    <!-- Settings: browsing -->
    <sys:String x:Key="LOC_BRP_HeaderIdle">When no game is running</sys:String>
    <sys:String x:Key="LOC_BRP_ShowIdlePresence">Show that I'm browsing Playnite</sys:String>
    <sys:String x:Key="LOC_BRP_IdlePlaceholders">Placeholders: {games} games in the library, {installed} installed games, {favorites} favorite games, {played} games played at least once, {playtime} total playtime. Hidden games are not counted.</sys:String>
    <sys:String x:Key="LOC_BRP_Signature">Better Rich Presence by Heet ·</sys:String>

    <!-- Settings: validation -->
    <sys:String x:Key="LOC_BRP_FallbackIdInvalid">The fallback Discord application ID must be a number.</sys:String>

    <!-- Game context menu -->
    <sys:String x:Key="LOC_BRP_MenuHide">Hide activity from Discord</sys:String>
    <sys:String x:Key="LOC_BRP_MenuShare">Share activity on Discord</sys:String>
    <sys:String x:Key="LOC_BRP_MenuSetApplication">Set Discord application ID…</sys:String>
    <sys:String x:Key="LOC_BRP_SetApplicationPrompt" xml:space="preserve">Discord application ID to use for this game.&#10;Leave empty to detect it automatically.</sys:String>
    <sys:String x:Key="LOC_BRP_InvalidApplicationId">A Discord application ID is a number.</sys:String>

    <!-- Notifications -->
    <sys:String x:Key="LOC_BRP_BuiltInWarning">Better Rich Presence: Playnite's built-in Discord presence is also enabled, so Discord may show two activities. Close Playnite and set "DiscordPresenceEnabled" to false in config.json (Playnite has no option for it in its settings).</sys:String>

    <!-- Seen by friends on Discord: defaults for new users, and the badge tooltip -->
    <sys:String x:Key="LOC_BRP_DefaultMatchedDetails">Launch with {library}</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultMatchedState">{playtime} played</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultFallbackDetails">{name}</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultFallbackState">{source} · {platform}</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultIdleDetails">Browsing the library</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultIdleState">{games} games</sys:String>
    <sys:String x:Key="LOC_BRP_BadgeText">via Playnite</sys:String>

</ResourceDictionary>
