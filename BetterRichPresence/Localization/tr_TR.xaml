<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Missing keys fall back to en_US. -->

    <!-- Settings: Discord application -->
    <sys:String x:Key="LOC_BRP_Enabled">Etkinliğimi Discord'da paylaş</sys:String>
    <sys:String x:Key="LOC_BRP_HeaderApplication">Discord uygulaması</sys:String>
    <sys:String x:Key="LOC_BRP_UseGameApplications">Discord oyunu tanıyorsa "&lt;oyun&gt; oynuyor" göster</sys:String>
    <sys:String x:Key="LOC_BRP_RefreshCatalog">Listeyi yenile</sys:String>
    <sys:String x:Key="LOC_BRP_CatalogDownloading">İndiriliyor…</sys:String>
    <sys:String x:Key="LOC_BRP_CatalogCount">Discord'un tanıdığı {0} oyun</sys:String>
    <sys:String x:Key="LOC_BRP_FallbackApplicationId">Yedek uygulama kimliği:</sys:String>
    <sys:String x:Key="LOC_BRP_FallbackImage">Yedek görsel:</sys:String>
    <sys:String x:Key="LOC_BRP_ResetApplication">Eklentinin uygulamasına sıfırla</sys:String>
    <sys:String x:Key="LOC_BRP_FallbackHelp">Discord'un tanımadığı oyunlar için ve kütüphaneye göz atarken kullanılır. Görsel, yedek uygulamanın bir asset anahtarı (Discord Developer Portal'da Rich Presence → Art Assets) veya bir görsel URL'sidir.</sys:String>

    <!-- Settings: presence text -->
    <sys:String x:Key="LOC_BRP_HeaderMatched">Discord oyunu tanıdığında metin</sys:String>
    <sys:String x:Key="LOC_BRP_HeaderFallback">Yedek uygulamayla metin</sys:String>
    <sys:String x:Key="LOC_BRP_Details">Ayrıntılar:</sys:String>
    <sys:String x:Key="LOC_BRP_State">Durum:</sys:String>
    <sys:String x:Key="LOC_BRP_MemberListShows">Üye listesinde gösterilen:</sys:String>
    <sys:String x:Key="LOC_BRP_StatusGameName">Oyun adı</sys:String>
    <sys:String x:Key="LOC_BRP_StatusApplicationName">Uygulama adı</sys:String>
    <sys:String x:Key="LOC_BRP_StatusState">Durum</sys:String>
    <sys:String x:Key="LOC_BRP_StatusDetails">Ayrıntılar</sys:String>
    <sys:String x:Key="LOC_BRP_GamePlaceholders">Değişkenler: {name} {platform} {source} {library} {playtime} {playcount} {completion} {genre} {developer} {year} {score}. Boş bir değerin yanındaki ayırıcılar kaldırılır ve tüm değerleri boş olan satır gizlenir.</sys:String>

    <!-- Settings: display -->
    <sys:String x:Key="LOC_BRP_HeaderDisplay">Görünüm</sys:String>
    <sys:String x:Key="LOC_BRP_ShowElapsedTime">Oturumda geçen süreyi göster</sys:String>
    <sys:String x:Key="LOC_BRP_ShowPlayniteBadge">Playnite logosunu oyun görselinde küçük bir rozet olarak göster</sys:String>
    <sys:String x:Key="LOC_BRP_ShowGameImage">Oyun görseli göster</sys:String>
    <sys:String x:Key="LOC_BRP_GameImageKind">Gösterilecek Playnite görseli:</sys:String>
    <sys:String x:Key="LOC_BRP_ImageIcon">Simge</sys:String>
    <sys:String x:Key="LOC_BRP_ImageCover">Kapak</sys:String>
    <sys:String x:Key="LOC_BRP_UploadImages">Discord'un gösterebilmesi için Playnite görsellerini ImgBB'ye yükle</sys:String>
    <sys:String x:Key="LOC_BRP_ImgbbApiKey">ImgBB API anahtarı:</sys:String>
    <sys:String x:Key="LOC_BRP_UploadHelpBefore">Anahtar olmadan hiçbir şey yüklenmez. Discord yalnızca çevrimiçi görselleri gösterebilir. Her görsel PNG'ye dönüştürülür ve ImgBB'ye yalnızca bir kez yüklenir: bağlantıya sahip herkes görebilir. Ücretsiz bir API anahtarını şuradan alın:</sys:String>
    <sys:String x:Key="LOC_BRP_UploadHelpAfter">(giriş yapın, ardından "Get API key"). Bu seçenek kapalıyken veya yükleme bitene kadar, Steam kapağı ya da oyunun Discord simgesi gösterilir.</sys:String>

    <!-- Settings: browsing -->
    <sys:String x:Key="LOC_BRP_HeaderIdle">Hiçbir oyun çalışmıyorken</sys:String>
    <sys:String x:Key="LOC_BRP_ShowIdlePresence">Playnite'a göz attığımı göster</sys:String>
    <sys:String x:Key="LOC_BRP_IdlePlaceholders">Değişkenler: {games} kütüphanedeki oyunlar, {installed} yüklü oyunlar, {favorites} favori oyunlar, {played} en az bir kez oynanan oyunlar, {playtime} toplam oyun süresi. Gizli oyunlar sayılmaz.</sys:String>
    <sys:String x:Key="LOC_BRP_Signature">Better Rich Presence, Heet tarafından ·</sys:String>

    <!-- Settings: validation -->
    <sys:String x:Key="LOC_BRP_FallbackIdInvalid">Yedek Discord uygulama kimliği bir sayı olmalıdır.</sys:String>

    <!-- Game context menu -->
    <sys:String x:Key="LOC_BRP_MenuHide">Etkinliği Discord'da gizle</sys:String>
    <sys:String x:Key="LOC_BRP_MenuShare">Etkinliği Discord'da paylaş</sys:String>
    <sys:String x:Key="LOC_BRP_MenuSetApplication">Discord uygulama kimliğini ayarla…</sys:String>
    <sys:String x:Key="LOC_BRP_SetApplicationPrompt" xml:space="preserve">Bu oyun için kullanılacak Discord uygulama kimliği.&#10;Otomatik algılamak için boş bırakın.</sys:String>
    <sys:String x:Key="LOC_BRP_InvalidApplicationId">Discord uygulama kimliği bir sayıdır.</sys:String>

    <!-- Notifications -->
    <sys:String x:Key="LOC_BRP_BuiltInWarning">Better Rich Presence: Playnite'ın yerleşik Discord durumu da açık, bu yüzden Discord iki etkinlik gösterebilir. Playnite'ı kapatın ve config.json dosyasında "DiscordPresenceEnabled" değerini false yapın (Playnite'ın ayarlarında bu seçenek yoktur).</sys:String>

    <!-- Seen by friends on Discord: defaults for new users, and the badge tooltip -->
    <sys:String x:Key="LOC_BRP_DefaultMatchedDetails">{library} ile başlatıldı</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultMatchedState">{playtime} oynandı</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultFallbackDetails">{name}</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultFallbackState">{source} · {platform}</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultIdleDetails">Kütüphaneye göz atıyor</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultIdleState">{games} oyun</sys:String>
    <sys:String x:Key="LOC_BRP_BadgeText">Playnite üzerinden</sys:String>

</ResourceDictionary>
