<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Missing keys fall back to en_US. -->

    <!-- Settings: Discord application -->
    <sys:String x:Key="LOC_BRP_Enabled">Discord에 내 활동 공유</sys:String>
    <sys:String x:Key="LOC_BRP_HeaderApplication">Discord 애플리케이션</sys:String>
    <sys:String x:Key="LOC_BRP_UseGameApplications">Discord가 게임을 알고 있으면 "&lt;게임&gt; 하는 중" 표시</sys:String>
    <sys:String x:Key="LOC_BRP_RefreshCatalog">목록 새로 고침</sys:String>
    <sys:String x:Key="LOC_BRP_CatalogDownloading">다운로드 중…</sys:String>
    <sys:String x:Key="LOC_BRP_CatalogCount">Discord가 아는 게임 {0}개</sys:String>
    <sys:String x:Key="LOC_BRP_FallbackApplicationId">대체 애플리케이션 ID:</sys:String>
    <sys:String x:Key="LOC_BRP_FallbackImage">대체 이미지:</sys:String>
    <sys:String x:Key="LOC_BRP_ResetApplication">플러그인 애플리케이션으로 초기화</sys:String>
    <sys:String x:Key="LOC_BRP_FallbackHelp">Discord가 모르는 게임과 라이브러리를 둘러볼 때 사용됩니다. 이미지는 대체 애플리케이션의 에셋 키(Discord Developer Portal의 Rich Presence → Art Assets) 또는 이미지 URL입니다.</sys:String>

    <!-- Settings: presence text -->
    <sys:String x:Key="LOC_BRP_HeaderMatched">Discord가 게임을 알고 있을 때의 텍스트</sys:String>
    <sys:String x:Key="LOC_BRP_HeaderFallback">대체 애플리케이션 사용 시 텍스트</sys:String>
    <sys:String x:Key="LOC_BRP_Details">세부 정보:</sys:String>
    <sys:String x:Key="LOC_BRP_State">상태:</sys:String>
    <sys:String x:Key="LOC_BRP_MemberListShows">멤버 목록에 표시:</sys:String>
    <sys:String x:Key="LOC_BRP_StatusGameName">게임 이름</sys:String>
    <sys:String x:Key="LOC_BRP_StatusApplicationName">애플리케이션 이름</sys:String>
    <sys:String x:Key="LOC_BRP_StatusState">상태</sys:String>
    <sys:String x:Key="LOC_BRP_StatusDetails">세부 정보</sys:String>
    <sys:String x:Key="LOC_BRP_GamePlaceholders">변수: {name} {platform} {source} {library} {playtime} {playcount} {completion} {genre} {developer} {year} {score}. 빈 값 옆의 구분 기호는 제거되며, 모든 값이 비어 있는 줄은 숨겨집니다.</sys:String>

    <!-- Settings: display -->
    <sys:String x:Key="LOC_BRP_HeaderDisplay">표시</sys:String>
    <sys:String x:Key="LOC_BRP_ShowElapsedTime">세션 경과 시간 표시</sys:String>
    <sys:String x:Key="LOC_BRP_ShowPlayniteBadge">게임 이미지에 Playnite 로고를 작은 배지로 표시</sys:String>
    <sys:String x:Key="LOC_BRP_ShowGameImage">게임 이미지 표시</sys:String>
    <sys:String x:Key="LOC_BRP_GameImageKind">표시할 Playnite 이미지:</sys:String>
    <sys:String x:Key="LOC_BRP_ImageIcon">아이콘</sys:String>
    <sys:String x:Key="LOC_BRP_ImageCover">커버</sys:String>
    <sys:String x:Key="LOC_BRP_UploadImages">Discord에서 표시할 수 있도록 Playnite 이미지를 ImgBB에 업로드</sys:String>
    <sys:String x:Key="LOC_BRP_ImgbbApiKey">ImgBB API 키:</sys:String>
    <sys:String x:Key="LOC_BRP_UploadHelpBefore">키가 없으면 아무것도 업로드되지 않습니다. Discord는 온라인에 있는 이미지만 표시할 수 있습니다. 각 이미지는 PNG로 변환되어 ImgBB에 한 번만 업로드되며, 링크가 있는 사람은 누구나 볼 수 있습니다. 무료 API 키는 다음에서 받을 수 있습니다:</sys:String>
    <sys:String x:Key="LOC_BRP_UploadHelpAfter">(로그인 후 "Get API key"). 이 옵션이 꺼져 있거나 업로드가 끝나기 전에는 Steam 커버 또는 게임의 Discord 아이콘이 대신 표시됩니다.</sys:String>

    <!-- Settings: browsing -->
    <sys:String x:Key="LOC_BRP_HeaderIdle">실행 중인 게임이 없을 때</sys:String>
    <sys:String x:Key="LOC_BRP_ShowIdlePresence">Playnite를 둘러보는 중임을 표시</sys:String>
    <sys:String x:Key="LOC_BRP_IdlePlaceholders">변수: {games} 라이브러리의 게임 수, {installed} 설치된 게임 수, {favorites} 즐겨찾기 게임 수, {played} 한 번 이상 플레이한 게임 수, {playtime} 총 플레이 시간. 숨긴 게임은 세지 않습니다.</sys:String>
    <sys:String x:Key="LOC_BRP_Signature">Better Rich Presence by Heet ·</sys:String>

    <!-- Settings: validation -->
    <sys:String x:Key="LOC_BRP_FallbackIdInvalid">대체 Discord 애플리케이션 ID는 숫자여야 합니다.</sys:String>

    <!-- Game context menu -->
    <sys:String x:Key="LOC_BRP_MenuHide">Discord에서 활동 숨기기</sys:String>
    <sys:String x:Key="LOC_BRP_MenuShare">Discord에 활동 공유</sys:String>
    <sys:String x:Key="LOC_BRP_MenuSetApplication">Discord 애플리케이션 ID 설정…</sys:String>
    <sys:String x:Key="LOC_BRP_SetApplicationPrompt" xml:space="preserve">이 게임에 사용할 Discord 애플리케이션 ID입니다.&#10;비워 두면 자동으로 감지합니다.</sys:String>
    <sys:String x:Key="LOC_BRP_InvalidApplicationId">Discord 애플리케이션 ID는 숫자입니다.</sys:String>

    <!-- Notifications -->
    <sys:String x:Key="LOC_BRP_BuiltInWarning">Better Rich Presence: Playnite에 내장된 Discord 상태 표시도 켜져 있어 Discord에 활동이 두 개 표시될 수 있습니다. Playnite를 종료하고 config.json에서 "DiscordPresenceEnabled"를 false로 바꾸세요(Playnite 설정에는 이 옵션이 없습니다).</sys:String>

    <!-- Seen by friends on Discord: defaults for new users, and the badge tooltip -->
    <sys:String x:Key="LOC_BRP_DefaultMatchedDetails">{library}에서 실행</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultMatchedState">플레이 시간 {playtime}</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultFallbackDetails">{name}</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultFallbackState">{source} · {platform}</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultIdleDetails">라이브러리 둘러보는 중</sys:String>
    <sys:String x:Key="LOC_BRP_DefaultIdleState">게임 {games}개</sys:String>
    <sys:String x:Key="LOC_BRP_BadgeText">Playnite 사용</sys:String>

</ResourceDictionary>
