<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BetterRichPresence</AssemblyName>
    <RootNamespace>BetterRichPresence</RootNamespace>
    <Version>0.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Playnite ships Playnite.SDK.dll itself: compile against it, never copy it to the output. -->
    <PackageReference Include="PlayniteSDK" Version="6.11.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    C# Dev Kit's design-time builds don't run the WPF markup compiler for .NET Framework
    projects, so the editor never sees InitializeComponent. Feed it the code the last real
    build generated; real builds are untouched.
  -->
  <Target Name="AddXamlGeneratedCodeForEditor" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' == 'true'">
    <ItemGroup>
      <_XamlGeneratedCode Include="$(IntermediateOutputPath)*.g.cs" />
      <Compile Include="@(_XamlGeneratedCode)" Condition="'@(Compile->AnyHaveMetadataValue('Identity', '%(_XamlGeneratedCode.Identity)'))' != 'true'" />
    </ItemGroup>
  </Target>

</Project>
